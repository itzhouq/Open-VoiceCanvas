# DeepSeek API（仅服务端使用，切勿使用 NEXT_PUBLIC_ 前缀）
DEEPSEEK_API_KEY=your_deepseek_api_key

# AWS Polly（仅服务端使用，切勿使用 NEXT_PUBLIC_ 前缀，否则密钥会打包进浏览器代码）
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# MiniMax
MINIMAX_API_KEY=your_minimax_api_key
MINIMAX_GROUP_ID=your_minimax_group_id

# 通义千问 API
QWEN_API_KEY=your_qwen_api_key

# Database
DATABASE_URL=your_database_url

# Authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret

# JWT
JWT_SECRET=your_jwt_secret

# OAuth Providers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
STRIPE_YEARLY_PRICE_ID=your_stripe_yearly_price_id
STRIPE_MONTHLY_PRICE_ID=your_stripe_monthly_price_id
STRIPE_10K_PRICE_ID=your_stripe_10k_price_id
STRIPE_1M_PRICE_ID=your_stripe_1m_price_id
STRIPE_3M_PRICE_ID=your_stripe_3m_price_id
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Google Analytics
NEXT_PUBLIC_GA_ID=your_google_analytics_id

# Resend Email
RESEND_API_KEY=
EMAIL_FROM=Onboarding@resend.dev
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Discord Integration
DISCORD_WEBHOOK_URL=your_discord_webhook_url 
# Trial & quota (commercial)
TRIAL_TEMPORARY_QUOTA=10000
TRIAL_DAYS=7
ALLOW_ANONYMOUS_TTS=false
